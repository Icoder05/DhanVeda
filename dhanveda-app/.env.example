# Copy to .env.local and fill in. Never commit real values.

# Neon Postgres connection string
DATABASE_URL=

# App URL (no trailing slash) and session secret (openssl rand -base64 32)
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=

# LLM providers (cascade order: Gemini -> Anthropic -> Groq -> OpenRouter)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Gmail SMTP for verification and 2FA e-mails (use an App Password)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Disposable-email check on signup (abstractapi.com)
ABSTRACT_API_KEY=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=false

# Header secret for /api/admin/migrate-userid
ADMIN_SECRET=

# Only for scripts/set-admin-password.mjs
ADMIN_EMAIL=
ADMIN_PASSWORD=
